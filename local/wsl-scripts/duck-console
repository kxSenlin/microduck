#!/usr/bin/env bash
# duck-console — 监控已经启动的容器鸭子（boot 模式）。
#
# 流程：
#   终端 A：scripts/duck-sim boot 4
#   终端 B：duck-console
#
# 窗口：shell / status（容器 + 健康）/ logs（所有鸭子合并）/ monitor-<字母>（每只一个实时面板）。
set -uo pipefail
REPO="$HOME/Pollen/microduck"
STATE="$HOME/.cache/duck-sim"
SESSION=duck
BROWSER_URL="http://localhost:${DUCK_SIM_VIEWER_PORT:-8091}"

cd "$REPO" || exit 1

ducks=$(sudo machinectl list --no-pager --no-legend 2>/dev/null \
    | awk '{print $1}' | grep -E '^duck-[a-z]$' | sort)

if [ -z "$ducks" ]; then
    cat <<EOF
没有正在运行的容器鸭子。

终端 A 启动（示例：4 只）：
  cd $REPO
  scripts/duck-sim boot 4

浏览器场景查看器：
  $BROWSER_URL

启动完成后，在终端 B 重新运行：duck-console
EOF
    exit 1
fi

journal_flags=""
for duck in $ducks; do
    journal_flags="$journal_flags -M $duck"
done

expected=""
for duck in $ducks; do
    expected="$expected monitor-${duck#duck-}"
done

if tmux has-session -t "$SESSION" 2>/dev/null; then
    current=""
    for name in $(tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null); do
        case "$name" in
            monitor-*) current="$current $name" ;;
        esac
    done
    # 窗口集合与当前鸭子不一致（上次跑的是别的数量）→ 拆掉重建
    if [ "$current" != "$expected" ]; then
        tmux kill-session -t "$SESSION" 2>/dev/null || true
    else
        exec tmux attach -t "$SESSION"
    fi
fi

tmux new-session -d -s "$SESSION" -n shell -c "$REPO"
tmux set-option -t "$SESSION" -g mouse on
tmux set-option -t "$SESSION" -g history-limit 50000

WINDOW_INDEX=1
add_window() {
    local name="$1" command="$2"
    tmux new-window -d -t "$SESSION:$WINDOW_INDEX" -n "$name" -c "$REPO" || return 1
    tmux send-keys -t "$SESSION:$WINDOW_INDEX" "$command" C-m
    WINDOW_INDEX=$((WINDOW_INDEX + 1))
}

add_window status "watch -n 2 duck-health"
add_window logs "sudo journalctl$journal_flags -u robotd -f"

# 每只鸭子一个实时面板
for duck in $ducks; do
    letter=${duck#duck-}
    add_window "monitor-$letter" "while :; do sudo $REPO/target/debug/robotctl --robot-socket $STATE/ducks/$duck/run/robotd.sock monitor; echo 'monitor exited — reconnecting in 2s'; sleep 2; done"
done

tmux send-keys -t "$SESSION:0" "echo '场景查看器: $BROWSER_URL'" C-m
tmux select-window -t "$SESSION:0"
exec tmux attach -t "$SESSION"