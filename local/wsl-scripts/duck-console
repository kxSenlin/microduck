#!/usr/bin/env bash
# duck-console — 监控已经启动的容器鸭子（boot 模式）。
#
# 流程：
#   终端 A：DUCK_SIM_VIEWER=viser scripts/duck-sim boot 2
#   终端 B：duck-console
#
# 本脚本不启动、不停止鸭子，只负责打开监控窗口。
set -uo pipefail
REPO="$HOME/Pollen/microduck"
STATE="$HOME/.cache/duck-sim"
SESSION=duck
BROWSER_URL="http://localhost:${DUCK_SIM_VIEWER_PORT:-8091}"

cd "$REPO" || exit 1

ducks=$(sudo machinectl list --no-pager --no-legend 2>/dev/null \
    | awk '{print $1}' | grep -E '^duck-[a-z]$' | sort)

if [ -z "$ducks" ]; then
    cat <<EOF
没有正在运行的容器鸭子。

终端 A 启动（示例：2 只）：
  cd $REPO
  DUCK_SIM_VIEWER=viser scripts/duck-sim boot 2

浏览器场景查看器：
  $BROWSER_URL

启动完成后，在终端 B 重新运行：duck-console
EOF
    exit 1
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach -t "$SESSION"
fi

# 窗口索引必须显式递增：不指定索引时 tmux 会尝试复用当前窗口的下一个编号，
# 与已存在的窗口冲突后报 "index N in use"，后续窗口全部创建失败。
tmux new-session -d -s "$SESSION" -n shell -c "$REPO"
tmux set-option -t "$SESSION" -g mouse on
tmux set-option -t "$SESSION" -g history-limit 50000

WINDOW_INDEX=1
add_window() {
    local name="$1" command="$2"
    tmux new-window -d -t "$SESSION:$WINDOW_INDEX" -n "$name" -c "$REPO" || return 1
    tmux send-keys -t "$SESSION:$WINDOW_INDEX" "$command" C-m
    WINDOW_INDEX=$((WINDOW_INDEX + 1))
}

add_window status "watch -n 2 'sudo machinectl list --no-pager'"

for duck in $ducks; do
    add_window "$duck" "sudo journalctl -M $duck -u robotd -f"
done

add_window body "tail -f $STATE/body.log"

HEALTH_COMMAND="watch -n 2 'for m in $ducks; do echo == \$m; sudo systemd-run --machine=\$m --pipe --wait --quiet /usr/local/bin/robotctl health 2>&1 | head -4; done'"
add_window health "$HEALTH_COMMAND"

tmux send-keys -t "$SESSION:0" "echo '场景查看器: $BROWSER_URL'" C-m
tmux select-window -t "$SESSION:0"
exec tmux attach -t "$SESSION"