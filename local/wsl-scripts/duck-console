#!/usr/bin/env bash
# duck-console — 起鸭子 + 打开监控 tab。
#   duck-console            单机模式（scripts/duck-sim）
#   duck-console boot 2     容器模式（scripts/duck-sim boot 2）
#   duck-console 4          同上（数字即容器数）
# 启动命令会"敲"进 shell tab，屏幕上可见；attach 立即发生，监控 tab 在后台等健康后创建。
set -uo pipefail
export GALLIUM_DRIVER=${GALLIUM_DRIVER:-d3d12}
REPO="$HOME/Pollen/microduck"
SESSION=duck
cd "$REPO" || exit 1

# 已存在会话：直接附上，不重启鸭子
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach -t "$SESSION"
fi

# 解析模式
MODE=single
N=1
case "${1:-}" in
    boot)    MODE=boot; N="${2:-1}" ;;
    ''|*[!0-9]*) MODE=single ;;
    *)       MODE=boot; N="$1" ;;
esac

# 建会话：先只有 shell tab，马上 attach
tmux new-session -d -s "$SESSION" -n shell -c "$REPO"
tmux set-option -t "$SESSION" -g mouse on
tmux set-option -t "$SESSION" -g history-limit 50000

if scripts/duck-sim status 2>/dev/null | grep -q healthy; then
    tmux send-keys -t "$SESSION:shell" 'scripts/duck-sim status' C-m
else
    if [ "$MODE" = boot ]; then
        tmux send-keys -t "$SESSION:shell" "scripts/duck-sim boot $N" C-m
    else
        tmux send-keys -t "$SESSION:shell" 'scripts/duck-sim' C-m
    fi

    # 后台等健康，然后创建监控 tab（-d：不抢当前焦点）
    (
        for _ in $(seq 1 180); do
            scripts/duck-sim status 2>/dev/null | grep -q healthy && break
            sleep 1
        done
        sleep 2
        tmux new-window -d -t "$SESSION" -n status  -c "$REPO" "watch -n 2 'scripts/duck-sim status'"
        tmux new-window -d -t "$SESSION" -n log     -c "$REPO" "scripts/duck-sim log"
        tmux new-window -d -t "$SESSION" -n simlog  -c "$REPO" "scripts/duck-sim simlog"
        tmux new-window -d -t "$SESSION" -n monitor -c "$REPO" "scripts/duck-sim monitor"
        if [ "$MODE" = boot ] && [ "$N" -gt 1 ]; then
            letters=abcdefghij
            names=""
            i=0
            while [ "$i" -lt "$N" ]; do
                names="$names duck-${letters:$i:1}"
                i=$((i + 1))
            done
            tmux new-window -d -t "$SESSION" -n ducks -c "$REPO" \
                "watch -n 2 'for d in$names; do echo \"== \$d\"; WHO=\$d scripts/duck-sim ctl health 2>&1 | head -2; done'"
        fi
    ) >/tmp/duck-console-tabs.log 2>&1 &
    disown 2>/dev/null || true
fi

tmux select-window -t "$SESSION:shell"
exec tmux attach -t "$SESSION"