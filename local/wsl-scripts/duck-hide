#!/usr/bin/env bash
# duck-hide — 把 MuJoCo 窗口从桌面隐藏（进程和仿真继续跑）
set -uo pipefail
export DISPLAY=${DISPLAY:-:0}
WID=$(xdotool search --name "MuJoCo" 2>/dev/null | head -1)
if [ -z "$WID" ]; then
    echo "no MuJoCo window — is the duck up? (duck-console / scripts/duck-sim)"
    exit 1
fi
xdotool windowunmap "$WID"
echo "MuJoCo window hidden (id $WID) — duck keeps running; duck-show to bring it back"